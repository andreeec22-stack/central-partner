# Production stack (docker-compose.prod.yml). Copy to .env and fill in.
# Local development uses apps/api/.env instead (see apps/api/.env.example).

# ── Database (container) ─────────────────────────────
POSTGRES_DB=central_partner
POSTGRES_USER=central
# Letters and digits only (it goes inside the connection URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Auth ─────────────────────────────────────────────
#   openssl rand -base64 48
JWT_SECRET=

# ── Public URL (invite/reset links and CORS) ─────────
APP_URL=https://app.example.com
WEB_PORT=80
# Refresh cookie over HTTPS only. Browsers accept it on http://localhost;
# set false only to try the stack over plain http on another host.
COOKIE_SECURE=true

# ── Runtime ──────────────────────────────────────────
LOG_LEVEL=info
# true in exactly ONE API replica (weekly cycle, surveys, report purge).
SCHEDULERS_ENABLED=true
# General API limit: requests per minute per signed-in user.
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
# Manual weekly-report generations per workspace per hour (Fase 4).
REPORT_GENERATIONS_PER_HOUR=3

# ── Email (invites, password reset). Empty = logged only ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Central Partner <noreply@centralpartner.com>

# ── File storage. Empty bucket = local volume (api-uploads) ──
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Error reporting (optional) ───────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── Images. Empty = built locally; CI deploys set IMAGE_TAG ──
# API_IMAGE=ghcr.io/<owner>/<repo>-api
# WEB_IMAGE=ghcr.io/<owner>/<repo>-web
# IMAGE_TAG=local

# ── Backups (scripts/backup.sh) ──────────────────────
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
# Optional off-site copy (needs the aws CLI on the server). Use a bucket of its own.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=central-partner
