# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Frontend URL, used in invite / password-reset links
APP_URL=http://localhost:5173

# ── Database / cache (docker compose up -d) ─────────
DATABASE_URL=postgresql://central:central@localhost:5432/central_partner
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800
BCRYPT_ROUNDS=10
# Production (Vercel frontend + Railway API on different domains): None + COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
# COOKIE_SECURE=true

# ── CORS (comma-separated) ───────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Rate limiting ────────────────────────────────────
# Set true in production behind Railway's proxy so X-Forwarded-For is trusted
TRUST_PROXY=false
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ── Email (invites + password reset only). Empty SMTP_HOST = log to console ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Central Partner <noreply@centralpartner.com>

# ── Later phases (not read yet) ──────────────────────
# MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_ADMIN_KEY=central-partner-dev-master-key
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=central-partner-files
# AWS_S3_REGION=us-east-1
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# SENTRY_DSN=
