# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Frontend URL, used in invite / password-reset links
APP_URL=http://localhost:5173

# ── Database / cache (docker compose up -d) ─────────
DATABASE_URL=postgresql://central:central@localhost:5432/central_partner
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800
BCRYPT_ROUNDS=10
# Production (Vercel frontend + Railway API on different domains): None + COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
# COOKIE_SECURE=true

# ── CORS (comma-separated) ───────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Rate limiting ────────────────────────────────────
# Set true in production behind Railway's proxy so X-Forwarded-For is trusted
TRUST_PROXY=false
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ── Email (invites + password reset only). Empty SMTP_HOST = log to console ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Central Partner <noreply@centralpartner.com>

# ── File storage. Empty AWS_S3_BUCKET = local disk (LOCAL_STORAGE_DIR) ──
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT=            # S3-compatible stores (MinIO, R2)
LOCAL_STORAGE_DIR=uploads
# Public URL of this API; empty = links are relative (/api/v1/...), fine behind the Vite proxy
API_PUBLIC_URL=
FILE_URL_TTL_SECONDS=86400

# ── WhatsApp (Twilio). Empty TWILIO_ACCOUNT_SID = log messages to console ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886

# ── Later phases (not read yet) ──────────────────────
# MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_ADMIN_KEY=central-partner-dev-master-key
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# SENTRY_DSN=

# Background jobs (weekly cycle, surveys, report cleanup). With several replicas keep them on in one.
SCHEDULERS_ENABLED=true
