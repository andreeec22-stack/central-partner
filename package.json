{
  "name": "central-partner",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "dev:api": "npm run dev -w @central-partner/api",
    "test:api": "npm run test -w @central-partner/api",
    "test:e2e": "npm run test -w @central-partner/e2e",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
